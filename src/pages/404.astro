---
// Branded 404 for the marketing site.
---
<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Coursed — Page not found</title>
<link rel="icon" href="/favicon.svg">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{--bg:#0F0D0B;--ink:#F6EFE4;--muted:#B3A897;--gold:#F0B429;--line:#3A322B}
  *{box-sizing:border-box}
  body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:radial-gradient(1100px 600px at 50% -20%,#241C14 0%,var(--bg) 58%);color:var(--ink);font-family:"Manrope",system-ui,sans-serif;text-align:center;padding:24px}
  h1{font-size:clamp(32px,6vw,56px);font-weight:800;letter-spacing:-.02em;margin:0 0 12px}
  h1 .g{color:var(--gold)}
  p{color:var(--muted);font-size:18px;max-width:44ch;margin:0 auto 26px}
  a.btn{display:inline-block;background:var(--gold);color:#171310;font-weight:800;padding:14px 24px;border-radius:12px;text-decoration:none;min-height:44px}
  a.btn:hover{filter:brightness(1.05)}
</style></head>
<body>
  <div>
    <h1>Page <span class="g">not found.</span></h1>
    <p>That page isn't here. Head back to the service scoreboard.</p>
    <a class="btn" href="/">Back to Coursed</a>
  </div>
</body></html>
